# Copiar a .env y completar. Ningun valor real debe subirse al repositorio.

# Modo demostracion: activo por defecto (datos de ejemplo, sin BD).
# Definir en "false" para usar el sistema completo con una base de datos real.
NEXT_PUBLIC_DEMO_MODE=true

# URL publica de la aplicacion (sin barra final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de datos MySQL
DATABASE_URL=mysql://usuario:password@localhost:3306/urbanreport

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Mapas y geocodificacion inversa (https://www.jawg.io)
NEXT_PUBLIC_JAWG_TOKEN=

# Clasificacion de reportes e informes mensuales (Anthropic)
ANTHROPIC_API_KEY=

# Almacenamiento de fotos (Cloudflare R2)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# Solo para los scripts de carga inicial (scripts/)
SEED_ADMIN_PASSWORD=
SEED_TECNICO_PASSWORD=
